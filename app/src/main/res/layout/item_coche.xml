<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginHorizontal="10dp"
    card_view:cardCornerRadius="20dp"
    card_view:cardElevation="12dp"
    android:foreground="?android:attr/selectableItemBackground"
    card_view:cardBackgroundColor="#1C1C1E">

    <LinearLayout
        android:orientation="vertical"
        android:padding="18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Marca y modelo -->
        <TextView
            android:id="@+id/txtNombreCoche"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mazda MX-5"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/racesport"
            android:textStyle="bold" />

        <!-- Detalles técnicos -->
        <TextView
            android:id="@+id/txtDetallesCoche"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gasolina · 6.5 L/100km · 2021"
            android:textSize="14sp"
            android:textColor="#BBBBBB"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/racingsansoneregular" />

        <!-- Autor -->
        <TextView
            android:id="@+id/txtCreadoPor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Añadido por: Toni"
            android:textSize="13sp"
            android:textColor="#FFD700"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/racingsansoneregular"
            android:textStyle="italic"
            android:visibility="visible" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
