<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <ProgressBar
        android:id="@+id/progressHistorial"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerRutas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/textoSinRutas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No hay rutas guardadas todavía."
        android:textSize="17sp"
        android:textColor="@color/cardSubtle"
        android:fontFamily="@font/racingsansoneregular"
        android:layout_centerInParent="true"
        android:visibility="gone"/>


</LinearLayout>
