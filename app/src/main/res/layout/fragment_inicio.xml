<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal">

        <!-- Mapa más grande -->
        <FrameLayout
            android:id="@+id/map_container"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:background="@drawable/bg_card_mapa"
            android:layout_marginBottom="24dp"
            android:elevation="6dp" />

        <!-- NUEVA SECCIÓN: Modo de conducción -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_racing"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:elevation="6dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Modo de conducción"
                android:textColor="#FFD700"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/spinnerModo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_spinner"
                android:spinnerMode="dropdown"
                android:popupBackground="#2C2C2C"
                android:theme="@style/ThemeOverlay.MaterialComponents.MaterialAlertDialog" />
        </LinearLayout>

        <!-- Último coche + Última ruta -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:weightSum="2">

            <!-- Coche -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card_racing"
                android:padding="12dp"
                android:layout_marginEnd="8dp"
                android:elevation="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Coche"
                    android:textColor="#FFD700"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/textCocheNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Supra GR"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Ruta -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card_racing"
                android:padding="12dp"
                android:layout_marginStart="8dp"
                android:elevation="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ruta"
                    android:textColor="#FFD700"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/textRutaNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Valencia - Madrid"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Estadísticas -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_racing"
            android:padding="16dp"
            android:elevation="6dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Consumo estimado"
                android:textColor="#FFD700"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textConsumo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="5.6 L/100km · 27€"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Botón deportivo -->
        <Button
            android:id="@+id/btnNuevaRuta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AÑADIR NUEVA RUTA"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:paddingVertical="14dp"
            android:elevation="6dp"
            android:background="@drawable/bg_button_deportivo"
            style="@style/Widget.MaterialComponents.Button" />

    </LinearLayout>
</ScrollView>