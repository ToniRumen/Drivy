<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal">

        <!-- Título -->
        <TextView
            android:id="@+id/textoBienvenida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:text="ÚLTIMA RUTA"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp"
            android:textSize="20sp"
            android:fontFamily="@font/racesport"
            android:textStyle="bold" />




        <!-- Mapa reducido -->
        <com.google.android.gms.maps.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginBottom="15dp"
            android:background="@drawable/bg_card_mapa"
            android:elevation="10dp"/>

        <!-- Modo de conducción -->
        <LinearLayout
            android:id="@+id/tarjetaModoConduccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_racing"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:elevation="6dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Modo de conducción"
                android:textColor="#FFD700"
                android:fontFamily="@font/racingsansoneregular"
                android:textSize="15sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/textoModoSeleccionado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No seleccionado"
                android:textColor="#AAAAAA"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="@font/racingsansoneregular"/>
        </LinearLayout>

        <!-- Coche + Ruta -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp"
            android:weightSum="2">

            <!-- Coche -->
            <LinearLayout
                android:id="@+id/tarjetaCoche"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card_racing"
                android:padding="12dp"
                android:layout_marginEnd="8dp"
                android:elevation="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Coche"
                    android:textColor="#FFD700"
                    android:fontFamily="@font/racingsansoneregular"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/textCocheNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SUPRA GR"
                    android:fontFamily="@font/racesport"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Ruta -->
            <LinearLayout
                android:id="@+id/tarjetaRuta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card_racing"
                android:padding="12dp"
                android:layout_marginStart="8dp"
                android:elevation="6dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">


            <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ruta"
                    android:textColor="#FFD700"
                    android:fontFamily="@font/racingsansoneregular"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/textRutaNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/racingsansoneregular"
                    android:text="Selecciona ruta"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tarjetaGasolinera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_racing"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:elevation="6dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textoGasolineraTitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gasolinera seleccionada"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="#FFD700"
                    android:fontFamily="@font/racingsansoneregular" />

                <TextView
                    android:id="@+id/textoGasolineraNombre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Repsol Avenida"
                    android:textSize="13sp"
                    android:textColor="@android:color/white"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/racingsansoneregular" />
            </LinearLayout>

            <TextView
                android:id="@+id/textoGasolineraPrecio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.62 €/L"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@android:color/holo_red_light"
                android:layout_gravity="center_vertical"
                android:fontFamily="@font/racingsansoneregular" />
        </LinearLayout>






        <!-- Estadísticas -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_racing"
            android:padding="16dp"
            android:elevation="6dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Consumo estimado"
                android:textAlignment="center"
                android:fontFamily="@font/racingsansoneregular"
                android:textSize="17sp"
                android:textColor="#FFD700"/>

            <TextView
                android:id="@+id/textConsumo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="12.5 L/100km"
                android:textAlignment="center"
                android:fontFamily="@font/racingsansoneregular"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <ProgressBar
                android:id="@+id/barraConsumo"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:progressDrawable="@drawable/custom_progress"
                android:max="100"
                android:progress="0" />


            <TextView
                android:id="@+id/textoComentario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:fontFamily="@font/racingsansoneregular"
                android:background="@drawable/bg_comentario_consumo"
                android:textSize="10dp"
                android:layout_gravity="center_horizontal"
                android:padding="5dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="0dp"/>
        </LinearLayout>

        <!-- Coste estimado separado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_racing"
            android:padding="16dp"
            android:elevation="6dp"
            android:layout_marginBottom="5dp">

            <TextView
                android:id="@+id/textoCosteEstimado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Coste estimado: --"
                android:textColor="#FFD700"
                android:textSize="16sp"
                android:fontFamily="@font/racesport"
                android:textStyle="bold"
                android:textAlignment="center"/>
        </LinearLayout>


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardarRuta"
            style="@style/Drivy.RacingButton"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_gravity="center"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="24dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="GUARDAR RUTA"
            android:textStyle="bold"
            android:textSize="11dp"
            android:textAllCaps="true"
            app:cornerRadius="32dp"
            app:strokeWidth="2dp"
            android:elevation="8dp"/>




    </LinearLayout>
</LinearLayout>
