<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo">

    <!-- TÍTULO ARRIBA -->
    <TextView
        android:id="@+id/tituloWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DRIVY"
        android:textSize="40sp"
        android:textColor="#FFFFFF"
        android:fontFamily="@font/racesport"
        android:textStyle="bold"
        android:layout_marginTop="60dp"
        android:layout_centerHorizontal="true"
        android:shadowColor="#66000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4" />

    <!-- SUBTÍTULO CENTRADO -->
    <TextView
        android:id="@+id/subtituloWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¡Tu experiencia comienza ahora!"
        android:textColor="#DDFFFFFF"
        android:textSize="16sp"
        android:fontFamily="@font/racingsansoneregular"
        android:layout_below="@id/tituloWelcome"
        android:layout_marginTop="12dp"
        android:layout_centerHorizontal="true" />

    <!-- BOTÓN LOGIN ABAJO -->
    <Button
        android:id="@+id/btnIrLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Iniciar sesión"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:backgroundTint="#9B59B6"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="20dp"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="12dp"
        android:background="@drawable/boton_morado" />

    <!-- BOTÓN REGISTRO ENCIMA DEL LOGIN -->
    <Button
        android:id="@+id/btnIrRegistro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Registrarse"
        android:textColor="#9B59B6"
        android:textStyle="bold"
        android:backgroundTint="@android:color/transparent"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_above="@id/btnIrLogin"
        android:layout_marginBottom="16dp"
        android:background="@drawable/boton_transparente_borde" />
</RelativeLayout>
