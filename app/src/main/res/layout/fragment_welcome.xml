<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo">

    <!-- TÍTULO ARRIBA -->
    <TextView
        android:id="@+id/tituloWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DRIVY"
        android:textSize="70sp"
        android:textColor="#D05430"
        android:fontFamily="@font/racesport"
        android:textStyle="bold"
        android:layout_marginTop="40dp"
        android:layout_centerHorizontal="true"
        android:shadowColor="#66000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4" />

    <!-- SUBTÍTULO CENTRADO -->
    <TextView
        android:id="@+id/subtituloWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cada kilómetro cuenta"
        android:textColor="#C8C6C6"
        android:textSize="30sp"
        android:fontFamily="@font/racingsansoneregular"
        android:layout_below="@id/tituloWelcome"
        android:layout_marginTop="12dp"
        android:layout_centerHorizontal="true" />

    <Button
        android:id="@+id/btnIrLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Iniciar sesión"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:background="@drawable/btn_login"
        android:padding="14dp"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnIrRegister"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Registrarse"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:background="@drawable/btn_register"
        android:padding="14dp" />

</RelativeLayout>
