<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_card_racing">

    <EditText
        android:id="@+id/inputOrigen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/ciudad_de_origen"
        android:focusable="false"
        android:clickable="true"
        android:fontFamily="@font/racingsansoneregular"
        android:background="@drawable/bg_edittext"
        android:textColor="#FFFFFF"
        android:textColorHint="#888888"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/inputDestino"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/ciudad_de_destino"
        android:focusable="false"
        android:fontFamily="@font/racingsansoneregular"
        android:clickable="true"
        android:background="@drawable/bg_edittext"
        android:textColor="#FFFFFF"
        android:textColorHint="#888888"
        android:layout_marginBottom="24dp"/>

</LinearLayout>
